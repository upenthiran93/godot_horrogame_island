"values": [{
"args": [true],
"method": &"black"
}, {
"args": [false],
"method": &"slats"
}, {
"args": [],
"method": &"hide_note"
}, {
"args": [1.4],
"method": &"fade_in"
}, {
"args": [false],
"method": &"slats"
}, {
"args": [NodePath("Cam_02_WakingUp")],
"method": &"cut_to"
}, {
"args": [5.0, 0.05],
"method": &"blur_to"
}, {
"args": ["Breathing, ragged. A high ringing in the ears.", 3.0],
"method": &"sfx"
}, {
"args": [0.0, 3.5],
"method": &"blur_to"
}, {
"args": ["(...Elias? ...No. The phone's dead. Where am I?)", 3.8],
"method": &"narrate"
}, {
"args": ["Wind sighing through the stones of the hollow", 3.0],
"method": &"sfx"
}, {
"args": ["(Something dragged me in here. These marks lead back to the foot of those steps.)", 5.449999999999999],
"method": &"narrate"
}, {
"args": [],
"method": &"hide_note"
}, {
"args": [false],
"method": &"slats"
}, {
"args": ["Far above: the faint hum of the lit path's lamps", 3.0],
"method": &"sfx"
}, {
"args": ["(The lamps on the rim. The path is right up there. I can see it.)", 4.65],
"method": &"narrate"
}, {
"args": ["(The steps are buried. No way up from this side. Only through.)", 4.550000000000001],
"method": &"narrate"
}, {
"args": ["Loose stones tick down the rockfall and stop", 2.5],
"method": &"sfx"
}, {
"args": [],
"method": &"hide_note"
}, {
"args": [false],
"method": &"slats"
}, {
"args": ["Silence. Water dripping into the well.", 3.0],
"method": &"sfx"
}, {
"args": ["(Houses. Roofless, old. Someone lived down here a long time ago.)", 4.65],
"method": &"narrate"
}, {
"args": [],
"method": &"hide_note"
}, {
"args": [false],
"method": &"slats"
}, {
"args": ["(Tally marks, one by every door. Someone counted the years.)", 4.4],
"method": &"narrate"
}, {
"args": ["Fingertips on the cut strokes. The last row stops mid-group.", 3.0],
"method": &"sfx"
}, {
"args": ["(The last row stops half done. All of them. At the same year.)", 4.5],
"method": &"narrate"
}, {
"args": [],
"method": &"hide_note"
}, {
"args": [false],
"method": &"slats"
}, {
"args": [NodePath("Cam_06_TheHealingWall_B")],
"method": &"cut_to"
}, {
"args": ["(A man lying down. Then the same man standing, holding a little stone. They were given something.)", 6.0],
"method": &"narrate"
}, {
"args": ["A faint glow in the carved crystals, or the moon on the stone", 3.0],
"method": &"sfx"
}, {
"args": [],
"method": &"hide_note"
}, {
"args": [false],
"method": &"slats"
}, {
"args": ["Old beds, laid out in a row. Dust. A rusted lantern.", 3.0],
"method": &"sfx"
}, {
"args": ["(Beds. Laid out in a row. For strangers.)", 3.45],
"method": &"narrate"
}, {
"args": [NodePath("Cam_07_TheGuestHouse_B")],
"method": &"cut_to"
}, {
"args": ["(A log. English. Not the villagers'.)", 3.25],
"method": &"narrate"
}, {
"args": ["Ship's log — first page", "...the savages have kept us alive past all reason. Hartley's leg, broken in three places, was whole by morning. I have seen the stone they used. They show it freely...", 6.0],
"method": &"show_note"
}, {
"args": ["Ship's log — second page", "...I have asked them how. They told us everything, down to the yearly gathering and the three stones. They think of me as a guest. I have not corrected them...", 6.0],
"method": &"show_note"
}, {
"args": ["Ship's log — third page", "...My country must have this. I will join their feast. I will take what they will not sell...", 5.0],
"method": &"show_note"
}, {
"args": ["CREAK — a floorboard, overhead. There is no overhead.", 2.5],
"method": &"sfx"
}, {
"args": ["(A floorboard. Upstairs. There is no upstairs.)", 3.75],
"method": &"narrate"
}, {
"args": [],
"method": &"hide_note"
}, {
"args": [false],
"method": &"slats"
}, {
"args": ["Stinger (low) — a tall figure in a long coat, standing in the lane", 2.5],
"method": &"sfx"
}, {
"args": ["(Someone is standing in the lane.)", 3.1],
"method": &"narrate"
}, {
"args": ["The lane is empty. Coat-hem prints in the mud.", 2.5],
"method": &"sfx"
}, {
"args": ["(Gone. There are muddy prints on the sill. A heavy coat's hem.)", 4.550000000000001],
"method": &"narrate"
}, {
"args": [],
"method": &"hide_note"
}, {
"args": [false],
"method": &"slats"
}, {
"args": ["The wind drops. The ring of stones stands ahead, very still.", 3.0],
"method": &"sfx"
}, {
"args": [NodePath("Cam_09_TheFestivalRing_B")],
"method": &"cut_to"
}, {
"args": ["Open hands carved on every inward face; three empty sockets", 3.0],
"method": &"sfx"
}, {
"args": ["(A ring of stones. Three sockets in the middle, empty. Something sat in each one.)", 5.5],
"method": &"narrate"
}, {
"args": [],
"method": &"hide_note"
}, {
"args": [false],
"method": &"slats"
}, {
"args": ["Dig tag", "SOCKET 1/3
CRYSTAL RECOVERED
E.R.

DO NOT REMOVE — OWNER'S ORDERS", 5.0],
"method": &"show_note"
}, {
"args": ["(Trenches. Tags. Fresh. Someone dug here recently, with orders.)", 4.6],
"method": &"narrate"
}, {
"args": ["Orange tape snaps in the wind. Fresh spoil heaps.", 3.0],
"method": &"sfx"
}, {
"args": [NodePath("Cam_10_TheDigSite_B")],
"method": &"cut_to"
}, {
"args": ["Dig log — page 41", "...third socket cleared. E. (security) objected again to opening the circle. Overruled by the owner.

The researcher keeps asking what the stones are for. Nobody tells her.

(the last page is stuck under the radio)", 8.0],
"method": &"show_note"
}, {
"args": [],
"method": &"hide_note"
}, {
"args": [false],
"method": &"slats"
}, {
"args": [NodePath("Cam_11_TheGenerator_B")],
"method": &"cut_to"
}, {
"args": [NodePath("Cam_11_TheGenerator_C")],
"method": &"cut_to"
}, {
"args": ["(A generator. If it runs, I get light. And a radio.)", 4.0],
"method": &"narrate"
}, {
"args": ["A fist of fuel into the tank. The cord, once, twice...", 2.5],
"method": &"sfx"
}, {
"args": ["ROAR — the generator catches. The whole hollow rings with it.", 3.0],
"method": &"sfx"
}, {
"args": ["(Too loud. The whole hollow heard that.)", 3.4],
"method": &"narrate"
}, {
"args": ["Far off in the dark: loose stone clatters. Something has heard.", 3.0],
"method": &"sfx"
}, {
"args": [],
"method": &"hide_note"
}, {
"args": [false],
"method": &"slats"
}, {
"args": [NodePath("Cam_12_TheRadio_B")],
"method": &"cut_to"
}, {
"args": ["Static. Under it, a voice you know.", 2.0],
"method": &"sfx"
}, {
"args": ["SGT. ELIAS (RADIO): ...is somebody there? Don't be afraid. It's me. It's Elias.", 5.0],
"method": &"narrate"
}, {
"args": ["SGT. ELIAS (RADIO): Stay where you are. The cargo lift at the ring will bring you up. The code is seven, three, nine, two.", 6.5],
"method": &"narrate"
}, {
"args": ["SGT. ELIAS (RADIO): Hurry. Don't go into the old houses. Come on, now.", 4.5],
"method": &"narrate"
}, {
"args": [],
"method": &"hide_note"
}, {
"args": [false],
"method": &"slats"
}, {
"args": ["(...Elias? That's Elias's voice.)", 3.05],
"method": &"narrate"
}, {
"args": ["(Seven, three, nine, two. It's asking for a card too.)", 4.1],
"method": &"narrate"
}, {
"args": [NodePath("Cam_13_TheWrongCode_B")],
"method": &"cut_to"
}, {
"args": ["Cargo Lift 2", "ENTER CODE:  7 3 9 2

INVALID CODE
INSERT KEYCARD", 7.0],
"method": &"show_note"
}, {
"args": ["Four beeps, then one long one: INVALID", 2.5],
"method": &"sfx"
}, {
"args": ["(Wrong. And it wants a keycard. Whoever sold me that code... wasn't telling the truth.)", 5.75],
"method": &"narrate"
}, {
"args": [],
"method": &"hide_note"
}, {
"args": [false],
"method": &"slats"
}, {
"args": ["The wind drops. The air smells of old smoke.", 3.0],
"method": &"sfx"
}, {
"args": ["(Burned. All of it. They didn't leave. They were killed.)", 4.25],
"method": &"narrate"
}, {
"args": [NodePath("Cam_14_TheBurnedQuarter_B")],
"method": &"cut_to"
}, {
"args": ["Bones, heaped together as if gathered. One hand still closed.", 3.0],
"method": &"sfx"
}, {
"args": ["(They were all gathered here. One of them is still holding the stone.)", 4.9],
"method": &"narrate"
}, {
"args": [],
"method": &"hide_note"
}, {
"args": [false],
"method": &"slats"
}, {
"args": ["(One of the company's. His keycard. He came down here and never left.)", 4.9],
"method": &"narrate"
}, {
"args": ["Keycard", "SECURITY — LEVEL 2
CARGO LIFT 2 / SERVICE PATH

(taken from the guard's jacket)", 5.5],
"method": &"show_note"
}, {
"args": ["(A flare. Light it. Slowly.)", 2.8],
"method": &"narrate"
}, {
"args": ["The flare spits, flares red, and the quarter jumps out of the dark", 3.0],
"method": &"sfx"
}, {
"args": [],
"method": &"hide_note"
}, {
"args": [false],
"method": &"slats"
}, {
"args": ["Stinger — a tall figure in a long coat, back turned, in the red light", 3.0],
"method": &"sfx"
}, {
"args": ["(There's someone there. A long coat. It's... a man.)", 4.0],
"method": &"narrate"
}, {
"args": ["It begins to turn. A brass button catches the flare.", 3.0],
"method": &"sfx"
}, {
"args": ["Nothing there. Wet coat-prints leading away.", 2.5],
"method": &"sfx"
}, {
"args": [],
"method": &"hide_note"
}, {
"args": [false],
"method": &"slats"
}, {
"args": ["The carving: the tall giver turns him black. A man on a cord. A stone rising from the sea.", 4.0],
"method": &"sfx"
}, {
"args": ["(The giver turned him black. A man in a coat on a cord. That's what's following me.)", 5.6],
"method": &"narrate"
}, {
"args": [NodePath("Cam_17_TheLastCarving_B")],
"method": &"cut_to"
}, {
"args": ["Stinger — slow steps in the ash, close behind", 2.5],
"method": &"sfx"
}, {
"args": [],
"method": &"hide_note"
}, {
"args": [false],
"method": &"slats"
}, {
"args": [NodePath("Cam_18_ItHunts_B")],
"method": &"cut_to"
}, {
"args": ["(Don't run. Don't breathe. Let it pass.)", 3.4],
"method": &"narrate"
}, {
"args": ["Footfalls in the ash, slowing at the doorway", 3.0],
"method": &"sfx"
}, {
"args": ["A long, slow sniff. The air tastes of him.", 3.0],
"method": &"sfx"
}, {
"args": ["It turns away", 2.0],
"method": &"sfx"
}, {
"args": ["It stands at the carving, watching the lane", 3.0],
"method": &"sfx"
}, {
"args": [],
"method": &"hide_note"
}, {
"args": [false],
"method": &"slats"
}, {
"args": [NodePath("Cam_19_TheRealCode_B")],
"method": &"cut_to"
}, {
"args": ["Slow footsteps far behind, in the ash", 3.0],
"method": &"sfx"
}, {
"args": [NodePath("Cam_19_TheRealCode_C")],
"method": &"cut_to"
}, {
"args": ["The radio is silent now, but its dial is still red", 3.0],
"method": &"sfx"
}, {
"args": ["Dig log — last page", "LIFT CREW: cargo lift 2 code is 2 6 0 4.
Change it after the ceremony.

Keycard at the gate. Ask security.", 7.0],
"method": &"show_note"
}, {
"args": ["(Not seven-three-nine-two. Two-six-zero-four. The radio lied.)", 4.5],
"method": &"narrate"
}, {
"args": [],
"method": &"hide_note"
}, {
"args": [false],
"method": &"slats"
}, {
"args": ["Cargo Lift 2", "ENTER CODE:  2 6 0 4
[card accepted]

CODE ACCEPTED
LIFT STARTING", 6.0],
"method": &"show_note"
}, {
"args": ["A long green beep: CODE ACCEPTED", 2.5],
"method": &"sfx"
}, {
"args": [NodePath("Cam_20_TheCargoLift_B")],
"method": &"cut_to"
}, {
"args": [NodePath("Cam_20_TheCargoLift_C")],
"method": &"cut_to"
}, {
"args": ["The safety gate clangs shut", 2.0],
"method": &"sfx"
}, {
"args": ["Motor whine. The platform lurches and starts to climb the wall.", 3.0],
"method": &"sfx"
}, {
"args": ["(Go. Go. Please go.)", 2.5],
"method": &"narrate"
}, {
"args": ["Below, in the floodlights: it has reached the foot of the lift. It stops.", 3.0],
"method": &"sfx"
}, {
"args": ["The generator coughs and dies. The floodlights go out one by one.", 3.0],
"method": &"sfx"
}, {
"args": [NodePath("Cam_20_TheCargoLift_D")],
"method": &"cut_to"
}, {
"args": ["(It stopped at the edge of the light. It didn't follow. It just watched me go.)", 5.35],
"method": &"narrate"
}, {
"args": [1.5],
"method": &"fade_out"
}, {
"args": [true],
"method": &"black"
}, {
"args": [false],
"method": &"slats"
}, {
"args": [],
"method": &"hide_note"
}]
}
